{
  "name": "community-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Provision AWS Lightsail forum environments from a single YAML file",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "community-hub-seed": "dist/bin/seed.js"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "seed": "node dist/bin/seed.js",
    "render:user-data": "tsc -p tsconfig.build.json && node dist/bin/render-user-data.js",
    "validate": "tsc -p tsconfig.build.json && node dist/bin/validate.js"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "3.1156.0",
    "@aws-sdk/client-lightsail": "3.1156.0",
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "aws-cdk-lib": "2.274.0",
    "commander": "15.0.0",
    "constructs": "10.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1146.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
