            [
              "#!/bin/sh
set -eu
umask 077
# Community Hub self-extracting launch script. The forum install script is
# gzip+base64 encoded below to fit the Lightsail user-data size limit; it is
# decoded to a 0700 file and executed. No secret values are present.
