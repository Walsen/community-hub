                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::change/*",
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01GetChange",
                },
                {
                  "Action": [
                    "ssm:GetParameter*",
                    "secretsmanager:GetSecretValue",
