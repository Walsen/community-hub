awAA
CH_PAYLOAD
chmod 0700 /usr/local/sbin/community-hub-install
export CH_BROKER_URL='",
              {
                "Fn::GetAtt": [
                  "BootstrapBrokerFunctionFunctionUrlAC0A0B84",
                  "FunctionUrl",
                ],
              },
              "'
export CH_HOSTED_ZONE_ID=''
exec /bin/bash /usr/local/sbin/community-hub-install
",
            ],
          ],
        },
      },
      "Type": "AWS::Lightsail::Instance",
    },
    "ForumdevLifecycleC1A28656": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "ForumdevInstanceE7E0854F",
      ],
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "LifecycleProviderframeworkonEventBC6CEDCD",
            "Arn",
          ],
        },
        "environment": "community-test",
        "forumId": "dev",
        "instanceName": "community-test-dev-instance",
      },
      "Type": "AWS::CloudFormation::CustomResource",
      "UpdateReplacePolicy": "Delete",
    },
    "ForumdevNodeRole47B59999": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:*",
                      ],
                    ],
                  },
                },
                "StringEquals": {
                  "aws:SourceAccount": "123456789012",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "ssm.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "ssm:UpdateInstanceInformation",
                    "ssm:ListInstanceAssociations",
                    "ssm:DescribeAssociation",
                    "ssm:GetDocument",
                    "ssm:UpdateInstanceAssociationStatus",
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenDataChannel",
                    "ec2messages:AcknowledgeMessage",
                    "ec2messages:DeleteMessage",
                    "ec2messages:FailMessage",
                    "ec2messages:GetEndpoint",
                    "ec2messages:GetMessages",
                    "ec2messages:SendReply",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "SsmAgentCore",
                },
                {
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/dev/*",
                      ],
                    ],
                  },
                  "Sid": "ReadForumParameters",
                },
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":secretsmanager:us-east-1:123456789012:secret:/community-hub/community-test/dev/*",
                      ],
                    ],
                  },
                  "Sid": "ReadForumSecrets",
                },
                {
                  "Action": "ssm:PutParameter",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/dev/api-key",
                      ],
                    ],
                  },
                  "Sid": "WriteApiKey",
                },
                {
                  "Action": [
                    "ssm:GetParameter*",
                    "secretsmanager:GetSecretValue",
                  ],
                  "Effect": "Deny",
                  "NotResource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/dev/*",
                        ],
                      ],
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:us-east-1:123456789012:secret:/community-hub/community-test/dev/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "DenyReadOutsidePrefix",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "node-policy",
          },
        ],
        "RoleName": "community-test-dev-node",
        "Tags": [
          {
            "Key": "community-hub:environment",
            "Value": "community-test",
          },
          {
            "Key": "community-hub:forum",
            "Value": "dev",
          },
        ],
      },
