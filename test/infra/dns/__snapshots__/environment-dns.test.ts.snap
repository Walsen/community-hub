    "ForumdevNodeRole47B59999": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:*",
                      ],
                    ],
                  },
                },
                "StringEquals": {
                  "aws:SourceAccount": "123456789012",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "ssm.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "ssm:UpdateInstanceInformation",
                    "ssm:ListInstanceAssociations",
                    "ssm:DescribeAssociation",
                    "ssm:GetDocument",
                    "ssm:UpdateInstanceAssociationStatus",
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenDataChannel",
                    "ec2messages:AcknowledgeMessage",
                    "ec2messages:DeleteMessage",
                    "ec2messages:FailMessage",
                    "ec2messages:GetEndpoint",
                    "ec2messages:GetMessages",
                    "ec2messages:SendReply",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "SsmAgentCore",
                },
                {
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/dev/*",
                      ],
                    ],
                  },
                  "Sid": "ReadForumParameters",
                },
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":secretsmanager:us-east-1:123456789012:secret:/community-hub/community-test/dev/*",
                      ],
                    ],
                  },
                  "Sid": "ReadForumSecrets",
                },
                {
                  "Action": "ssm:PutParameter",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/dev/api-key",
                      ],
                    ],
                  },
                  "Sid": "WriteApiKey",
                },
                {
                  "Action": "route53:ChangeResourceRecordSets",
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "route53:ChangeResourceRecordSetsActions": [
                        "UPSERT",
                        "DELETE",
                      ],
                      "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
                        "_acme-challenge.dev.example.org",
                      ],
                      "route53:ChangeResourceRecordSetsRecordTypes": [
                        "TXT",
                      ],
                    },
                    "Null": {
                      "route53:ChangeResourceRecordSetsActions": "false",
                      "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
                      "route53:ChangeResourceRecordSetsRecordTypes": "false",
                    },
                  },
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::hostedzone/",
                        {
                          "Ref": "DnsDnsZone8FE8EC4B",
                        },
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01Change",
                },
                {
                  "Action": "route53:ListResourceRecordSets",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::hostedzone/",
                        {
                          "Ref": "DnsDnsZone8FE8EC4B",
                        },
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01ReadZone",
                },
                {
                  "Action": "route53:GetChange",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::change/*",
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01GetChange",
                },
                {
                  "Action": [
                    "ssm:GetParameter*",
                    "secretsmanager:GetSecretValue",
                  ],
                  "Effect": "Deny",
                  "NotResource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/dev/*",
                        ],
                      ],
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:us-east-1:123456789012:secret:/community-hub/community-test/dev/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "DenyReadOutsidePrefix",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "node-policy",
          },
        ],
