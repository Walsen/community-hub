CH_PAYLOAD
chmod 0700 /usr/local/sbin/community-hub-install
export CH_BROKER_URL='",
              {
                "Fn::GetAtt": [
                  "BootstrapBrokerFunctionFunctionUrlAC0A0B84",
                  "FunctionUrl",
                ],
              },
              "'
export CH_HOSTED_ZONE_ID='Z0123456789ABCDEFGHIJ'
exec /bin/bash /usr/local/sbin/community-hub-install
",
            ],
          ],
        },
      },
      "Type": "AWS::Lightsail::Instance",
    },
    "ForummainLifecycle050F61C3": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "ForummainInstance4623882C",
      ],
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "LifecycleProviderframeworkonEventBC6CEDCD",
            "Arn",
          ],
        },
        "environment": "community-test",
        "forumId": "main",
        "instanceName": "community-test-main-instance",
      },
      "Type": "AWS::CloudFormation::CustomResource",
      "UpdateReplacePolicy": "Delete",
    },
    "ForummainNodeRole264F3C16": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:*",
                      ],
                    ],
                  },
                },
                "StringEquals": {
                  "aws:SourceAccount": "123456789012",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "ssm.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "ssm:UpdateInstanceInformation",
                    "ssm:ListInstanceAssociations",
                    "ssm:DescribeAssociation",
                    "ssm:GetDocument",
                    "ssm:UpdateInstanceAssociationStatus",
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenDataChannel",
                    "ec2messages:AcknowledgeMessage",
                    "ec2messages:DeleteMessage",
                    "ec2messages:FailMessage",
                    "ec2messages:GetEndpoint",
                    "ec2messages:GetMessages",
                    "ec2messages:SendReply",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "SsmAgentCore",
                },
                {
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/main/*",
                      ],
                    ],
                  },
                  "Sid": "ReadForumParameters",
                },
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":secretsmanager:us-east-1:123456789012:secret:/community-hub/community-test/main/*",
                      ],
                    ],
                  },
                  "Sid": "ReadForumSecrets",
                },
                {
                  "Action": "ssm:PutParameter",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/main/api-key",
                      ],
                    ],
                  },
                  "Sid": "WriteApiKey",
                },
                {
                  "Action": "route53:ChangeResourceRecordSets",
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "route53:ChangeResourceRecordSetsActions": [
                        "UPSERT",
                        "DELETE",
                      ],
                      "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
                        "_acme-challenge.forum.example.org",
                      ],
                      "route53:ChangeResourceRecordSetsRecordTypes": [
                        "TXT",
                      ],
                    },
                    "Null": {
                      "route53:ChangeResourceRecordSetsActions": "false",
                      "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
                      "route53:ChangeResourceRecordSetsRecordTypes": "false",
                    },
                  },
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::hostedzone/Z0123456789ABCDEFGHIJ",
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01Change",
                },
                {
                  "Action": "route53:ListResourceRecordSets",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::hostedzone/Z0123456789ABCDEFGHIJ",
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01ReadZone",
                },
                {
                  "Action": "route53:GetChange",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":route53:::change/*",
                      ],
                    ],
                  },
                  "Sid": "AcmeDns01GetChange",
                },
                {
                  "Action": [
                    "ssm:GetParameter*",
                    "secretsmanager:GetSecretValue",
                  ],
                  "Effect": "Deny",
                  "NotResource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":ssm:us-east-1:123456789012:parameter/community-hub/community-test/main/*",
                        ],
                      ],
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:us-east-1:123456789012:secret:/community-hub/community-test/main/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "DenyReadOutsidePrefix",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "node-policy",
          },
        ],
        "RoleName": "community-test-main-node",
        "Tags": [
          {
            "Key": "community-hub:environment",
            "Value": "community-test",
          },
          {
            "Key": "community-hub:forum",
            "Value": "main",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
